/*
  Access-Control-Allow-Origin: *
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Access-Control-Allow-Headers: *

/*.wasm
  Content-Type: application/wasm
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=31536000, immutable

/hl/*
  Access-Control-Allow-Origin: *
  Accept-Ranges: bytes
  Cache-Control: public, max-age=31536000, immutable
